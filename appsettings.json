{
  "ConnectionStrings": {
    "Default": "Data Source=fakturio.db",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "fakturio",
    "Audience": "fakturio",
    "Key": "",
    "ExpireMinutes": 60
  },
  "Admin": {
    "Emails": []
  },
  "Cache": {
    "Enabled": true,
    "UseRedis": true,
    "RedisInstanceName": "fakturio:",
    "ReportsSeconds": 60,
    "CompanySeconds": 300
  },
  "DisableHttpsRedirection": false,
  "DataProtection": {
    "KeysPath": "dp-keys"
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "PublicPermitLimit": 60,
    "PublicWindowSeconds": 60,
    "IntegrationsPermitLimit": 30,
    "IntegrationsWindowSeconds": 60
  },
  "OverdueSync": {
    "Enabled": true,
    "RunAtHourUtc": 6,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": true,
    "StartupDelaySeconds": 15,
    "DisabledRecheckHours": 1
  },
  "BullMQ": {
    "Enabled": true,
    "Prefix": "fakturio",
    "ReminderQueueName": "reminders",
    "ReminderSchedulerId": "reminder-daily",
    "SettingsSyncSeconds": 60
  },
  "ReminderJob": {
    "Enabled": true,
    "RunAtHourUtc": 7,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": false,
    "StartupDelaySeconds": 20,
    "DisabledRecheckHours": 1,
    "WithinDays": 7,
    "OnlyOverdue": false,
    "MinDaysBetweenReminders": 3,
    "MarkAsSent": true
  },
  "RecurringInvoices": {
    "Enabled": true,
    "IntervalHours": 1,
    "StartupDelaySeconds": 45,
    "DisabledRecheckHours": 1
  },
  "Registry": {
    "AresBaseUrl": "https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/",
    "RpoBaseUrl": "https://api.statistics.sk/rpo/v1/",
    "SubjektBaseUrl": "https://api.subjekt.sk/v1/",
    "OrsfBaseUrl": "https://api.orsf.sk/v1/",
    "ViesBaseUrl": "https://ec.europa.eu/taxation_customs/vies/rest-api/",
    "OrsrBaseUrl": "https://sluzby.orsr.sk/api/",
    "OpenIbanBaseUrl": "https://openiban.com/",
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org/",
    "RuianBaseUrl": "https://ags.cuzk.gov.cz/arcgis/rest/services/RUIAN/Vyhledavaci_sluzba_nad_daty_RUIAN/MapServer/exts/GeocodeSOE/",
    "OpenSanctionsBaseUrl": "https://api.opensanctions.org/",
    "RestCountriesBaseUrl": "https://restcountries.com/v3.1/",
    "AdisregBaseUrl": "https://adisrws.mfcr.cz/dpr/axis2/services/rozhraniCRPDPH.rozhraniCRPDPHSOAP",
    "IsirBaseUrl": "https://isir.justice.cz:8443/isir_cuzk_ws/IsirWsCuzkService",
    "RegisterUzBaseUrl": "https://www.registeruz.sk/cruz-public/api/",
    "RpvsBaseUrl": "https://rpvs.gov.sk/opendatav2/",
    "RegistrSmluvBaseUrl": "https://smlouvy.gov.cz/",
    "GleifBaseUrl": "https://api.gleif.org/api/v1/",
    "PreferOrsf": true,
    "TimeoutSeconds": 15
  },
  "Fx": {
    "FrankfurterBaseUrl": "https://api.frankfurter.dev/v1/",
    "CnbBaseUrl": "https://www.cnb.cz/cs/financni-trhy/devizovy-trh/kurzy-devizoveho-trhu/kurzy-devizoveho-trhu/",
    "NbsBaseUrl": "https://nbs.sk/export/sk/exchange-rate/",
    "EcbDailyFxUrl": "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml",
    "TimeoutSeconds": 10,
    "CacheSeconds": 3600
  },
  "Turnstile": {
    "Enabled": false,
    "SiteKey": "",
    "Secret": ""
  },
  "Email": {
    "Provider": "None",
    "FromAddress": "",
    "FromName": "Fakturio",
    "ReplyTo": "",
    "PublicAppBaseUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": ""
    },
    "Resend": {
      "ApiKey": "",
      "BaseUrl": "https://api.resend.com/"
    }
  },

  "Banking": {
    "Psd2Sandbox": {
      "Enabled": false
    }
  },
  "LogoStorage": {
    "RootPath": "uploads",
    "MaxBytes": 2097152,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/jpg",
      "image/webp"
    ]
  },
  "AttachmentStorage": {
    "RootPath": "uploads",
    "MaxBytes": 8388608,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/jpg",
      "image/webp",
      "application/pdf",
      "image/heic",
      "image/heif"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
