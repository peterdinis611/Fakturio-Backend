{
  "ConnectionStrings": {
    "Default": "Data Source=fakturio.db"
  },
  "Jwt": {
    "Issuer": "fakturio",
    "Audience": "fakturio",
    "Key": "dev-only-change-me-fakturio-jwt-secret-key-32+",
    "ExpireMinutes": 10080
  },
  "Cache": {
    "Enabled": true,
    "ReportsSeconds": 60,
    "CompanySeconds": 300
  },
  "OverdueSync": {
    "Enabled": true,
    "RunAtHourUtc": 6,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": true,
    "StartupDelaySeconds": 15,
    "DisabledRecheckHours": 1
  },
  "ReminderJob": {
    "Enabled": true,
    "RunAtHourUtc": 7,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": false,
    "StartupDelaySeconds": 20,
    "DisabledRecheckHours": 1,
    "WithinDays": 7,
    "OnlyOverdue": false,
    "MinDaysBetweenReminders": 3,
    "MarkAsSent": false
  },
  "Registry": {
    "AresBaseUrl": "https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/",
    "RpoBaseUrl": "https://api.statistics.sk/rpo/v1/",
    "TimeoutSeconds": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
