{
  "ConnectionStrings": {
    "Default": "Data Source=fakturio.db"
  },
  "Cache": {
    "Enabled": true,
    "ReportsSeconds": 60,
    "CompanySeconds": 300
  },
  "OverdueSync": {
    "Enabled": true,
    "RunAtHourUtc": 6,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": true,
    "StartupDelaySeconds": 15,
    "DisabledRecheckHours": 1
  },
  "ReminderJob": {
    "Enabled": true,
    "RunAtHourUtc": 7,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": false,
    "StartupDelaySeconds": 20,
    "DisabledRecheckHours": 1,
    "WithinDays": 7,
    "OnlyOverdue": false,
    "MinDaysBetweenReminders": 3,
    "MarkAsSent": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
