{
  "ConnectionStrings": {
    "Default": "Data Source=fakturio.db",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "fakturio",
    "Audience": "fakturio",
    "Key": "dev-only-change-me-fakturio-jwt-secret-key-32+",
    "ExpireMinutes": 10080
  },
  "Admin": {
    "Emails": [
      "demo@fakturio.sk"
    ]
  },
  "Cache": {
    "Enabled": true,
    "UseRedis": true,
    "RedisInstanceName": "fakturio:",
    "ReportsSeconds": 60,
    "CompanySeconds": 300
  },
  "DisableHttpsRedirection": false,
  "OverdueSync": {
    "Enabled": true,
    "RunAtHourUtc": 6,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": true,
    "StartupDelaySeconds": 15,
    "DisabledRecheckHours": 1
  },
  "ReminderJob": {
    "Enabled": true,
    "RunAtHourUtc": 7,
    "RunAtMinuteUtc": 0,
    "RunOnStartup": false,
    "StartupDelaySeconds": 20,
    "DisabledRecheckHours": 1,
    "WithinDays": 7,
    "OnlyOverdue": false,
    "MinDaysBetweenReminders": 3,
    "MarkAsSent": true
  },
  "RecurringInvoices": {
    "Enabled": true,
    "IntervalHours": 1,
    "StartupDelaySeconds": 45,
    "DisabledRecheckHours": 1
  },
  "Registry": {
    "AresBaseUrl": "https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/",
    "RpoBaseUrl": "https://api.statistics.sk/rpo/v1/",
    "SubjektBaseUrl": "https://api.subjekt.sk/v1/",
    "OrsfBaseUrl": "https://api.orsf.sk/v1/",
    "ViesBaseUrl": "https://ec.europa.eu/taxation_customs/vies/rest-api/",
    "OrsrBaseUrl": "https://sluzby.orsr.sk/api/",
    "OpenIbanBaseUrl": "https://openiban.com/",
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org/",
    "AdisregBaseUrl": "https://adisrws.mfcr.cz/dpr/axis2/services/rozhraniCRPDPH.rozhraniCRPDPHSOAP",
    "IsirBaseUrl": "https://isir.justice.cz:8443/isir_cuzk_ws/IsirWsCuzkService",
    "RegisterUzBaseUrl": "https://www.registeruz.sk/cruz-public/api/",
    "PreferOrsf": true,
    "TimeoutSeconds": 15
  },
  "Fx": {
    "FrankfurterBaseUrl": "https://api.frankfurter.dev/v1/",
    "CnbBaseUrl": "https://www.cnb.cz/cs/financni-trhy/devizovy-trh/kurzy-devizoveho-trhu/kurzy-devizoveho-trhu/",
    "NbsBaseUrl": "https://nbs.sk/export/sk/exchange-rate/",
    "TimeoutSeconds": 10,
    "CacheSeconds": 3600
  },
  "LogoStorage": {
    "RootPath": "uploads",
    "MaxBytes": 2097152,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/jpg",
      "image/webp",
      "image/svg+xml"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "AllowedHosts": "*"
}
