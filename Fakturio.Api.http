@host = http://localhost:5148

### Health
GET {{host}}/api/health

### Upsert company (seller)
PUT {{host}}/api/company
Content-Type: application/json

{
  "name": "Fakturio s.r.o.",
  "legalForm": "s.r.o.",
  "ico": "36000001",
  "dic": "2020328755",
  "icDph": "SK2020328755",
  "isVatPayer": true,
  "commercialRegister": "Obchodný register OS Bratislava I, oddiel Sro, vložka 12345/B",
  "email": "info@fakturio.sk",
  "invoiceEmail": "faktury@fakturio.sk",
  "phone": "+421900123456",
  "website": "https://fakturio.sk",
  "contactPerson": "Peter Dinis",
  "street": "Dunajská 1",
  "city": "Bratislava",
  "postalCode": "811 08",
  "country": "SK",
  "bankIban": "SK3112000000198742637541",
  "bankBic": "GIBASKBX",
  "bankName": "VÚB banka",
  "defaultDueDays": 14,
  "defaultVatRate": 23,
  "defaultCurrency": "EUR",
  "invoicePrefix": "FA",
  "defaultPaymentMethod": "bank_transfer",
  "defaultConstantSymbol": "0308",
  "defaultInvoiceNotes": "Ďakujeme za spoluprácu.",
  "invoiceFooter": "Spoločnosť je zapísaná v OR."
}

### Company summary
GET {{host}}/api/company/summary

### Company status / completeness
GET {{host}}/api/company/status

### Patch invoice defaults only
PATCH {{host}}/api/company/defaults
Content-Type: application/json

{
  "defaultDueDays": 21,
  "invoicePrefix": "FA"
}

### Create customer
# @name createCustomer
POST {{host}}/api/customers
Content-Type: application/json

{
  "name": "ACME s.r.o.",
  "ico": "35757442",
  "dic": "2020263435",
  "icDph": "SK2020263435",
  "email": "faktury@acme.sk",
  "street": "Hlavná 1",
  "city": "Bratislava",
  "postalCode": "811 01",
  "country": "SK"
}

### Create invoice
# @name createInvoice
POST {{host}}/api/invoices
Content-Type: application/json

{
  "customerId": "{{createCustomer.response.body.$.id}}",
  "status": "Issued",
  "items": [
    {
      "description": "Web development – október 2026",
      "unit": "hod",
      "quantity": 40,
      "unitPrice": 45,
      "vatRate": 23
    }
  ]
}

### Mark paid (with date)
POST {{host}}/api/invoices/{{createInvoice.response.body.$.id}}/pay
Content-Type: application/json

{
  "paidAt": "2026-10-25"
}

### Cancel invoice
# @name createToCancel
POST {{host}}/api/invoices
Content-Type: application/json

{
  "customerId": "{{createCustomer.response.body.$.id}}",
  "status": "Issued",
  "items": [
    { "description": "To cancel", "quantity": 1, "unitPrice": 10, "vatRate": 23 }
  ]
}

###
POST {{host}}/api/invoices/{{createToCancel.response.body.$.id}}/cancel
Content-Type: application/json

{
  "reason": "Chybná faktúra – opravíme a vystavíme znova"
}

### Stats
GET {{host}}/api/invoices/stats

### Reminders (due in 7 days + overdue)
GET {{host}}/api/invoices/reminders?withinDays=7

### Mark reminder sent
POST {{host}}/api/invoices/{{createInvoice.response.body.$.id}}/reminders/mark-sent

### Sync overdue statuses
POST {{host}}/api/invoices/sync-overdue

### Download PDF
GET {{host}}/api/invoices/{{createInvoice.response.body.$.id}}/pdf

### List invoices
GET {{host}}/api/invoices?page=1&pageSize=20&overdueOnly=false

### Reports – overview
GET {{host}}/api/reports/overview?from=2026-01-01&to=2026-12-31

### Reports – monthly revenue
GET {{host}}/api/reports/revenue/monthly?year=2026

### Reports – aging
GET {{host}}/api/reports/aging?largestLimit=10

### Reports – top customers
GET {{host}}/api/reports/customers/top?limit=10&from=2026-01-01&to=2026-12-31

### Reports – VAT summary
GET {{host}}/api/reports/vat?from=2026-01-01&to=2026-12-31

### Export – invoices CSV
GET {{host}}/api/exports/invoices.csv?from=2026-01-01&to=2026-12-31

### Export – VAT CSV
GET {{host}}/api/exports/vat.csv?from=2026-01-01&to=2026-12-31

### Search – global
GET {{host}}/api/search?q=ACME&limit=20&types=All

### Search – customers
GET {{host}}/api/search/customers?q=ACME&page=1&pageSize=20

### Search – invoices
GET {{host}}/api/search/invoices?q=2026&page=1&pageSize=20

### Search – validation (too short)
GET {{host}}/api/search?q=a
