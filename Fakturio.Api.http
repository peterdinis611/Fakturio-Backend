@host = http://localhost:5148

### Health
GET {{host}}/api/health

### Upsert company (seller)
PUT {{host}}/api/company
Content-Type: application/json

{
  "name": "Fakturio s.r.o.",
  "ico": "36000001",
  "dic": "2020328755",
  "icDph": "SK2020328755",
  "email": "info@fakturio.sk",
  "street": "Dunajská 1",
  "city": "Bratislava",
  "postalCode": "811 08",
  "country": "SK",
  "bankIban": "SK3112000000198742637541",
  "bankBic": "GIBASKBX",
  "defaultDueDays": 14,
  "defaultVatRate": 23,
  "defaultCurrency": "EUR",
  "invoicePrefix": "FA"
}

### Create customer
# @name createCustomer
POST {{host}}/api/customers
Content-Type: application/json

{
  "name": "ACME s.r.o.",
  "ico": "35757442",
  "dic": "2020263435",
  "icDph": "SK2020263435",
  "email": "faktury@acme.sk",
  "street": "Hlavná 1",
  "city": "Bratislava",
  "postalCode": "811 01",
  "country": "SK"
}

### List customers (paged)
GET {{host}}/api/customers?page=1&pageSize=20&search=ACME

### Create invoice (draft)
# @name createInvoice
POST {{host}}/api/invoices
Content-Type: application/json

{
  "customerId": "{{createCustomer.response.body.$.id}}",
  "status": "Draft",
  "items": [
    {
      "description": "Web development – október 2026",
      "unit": "hod",
      "quantity": 40,
      "unitPrice": 45,
      "vatRate": 23
    },
    {
      "description": "Hosting",
      "unit": "mes",
      "quantity": 1,
      "unitPrice": 15,
      "vatRate": 23
    }
  ]
}

### Issue invoice
PATCH {{host}}/api/invoices/{{createInvoice.response.body.$.id}}/status
Content-Type: application/json

{
  "status": "Issued"
}

### Duplicate invoice
POST {{host}}/api/invoices/{{createInvoice.response.body.$.id}}/duplicate

### List invoices
GET {{host}}/api/invoices?page=1&pageSize=20

### Invalid customer (validation demo)
POST {{host}}/api/customers
Content-Type: application/json

{
  "name": "",
  "ico": "123",
  "email": "not-an-email",
  "postalCode": "ABC"
}
